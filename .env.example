# Copy this file to .env and fill in the two tokens. Nothing else has to change
# for a local demo. `.env` is git-ignored — never commit it.

# ---------------------------------------------------------------------------
# 1. Your AI model server. REQUIRED.
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. For Ollama, this is the machine running it —
# use its LAN address, not localhost, if it is on another machine.
# Which model gets used is config/models.yaml, not here.
REMOTE_MODEL_BASE_URL=http://192.168.0.184:11434/v1
REMOTE_MODEL_API_KEY=

# ---------------------------------------------------------------------------
# 2. Demo passwords. REQUIRED — pick any two random strings, 16+ characters.
# ---------------------------------------------------------------------------
# These are what you type into the console's login box. The admin token also
# unlocks the Tune panel and the full model reasoning in traces.
# Make them different from each other: the customer token is checked first, so
# two identical tokens log you in as the customer and the Tune panel becomes
# unreachable.
DEMO_CUSTOMER_TOKEN=
DEMO_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 3. Everything below has a working default. Change only if you need to.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
MODEL_CONFIG_PATH=config/models.yaml

# The knowledge base config/knowledge.yaml retrieves from. Compose sets this to
# the demo's own stand-in and ignores what is here. Set it when you run on the
# host (port 8000, not 8080) or when you point at a real knowledge base.
KNOWLEDGE_BASE_URL=http://localhost:8000/mock-kb

# How many earlier exchanges the assistant is shown. Higher remembers more and
# costs more tokens; too high and small models lose track.
HISTORY_TURNS=8

# bootstrap = one fact-checker. dual_judge = two, and they must agree.
ASSURANCE_MODE=bootstrap

# Where a handed-off conversation is posted. The demo has nothing listening.
WEBHOOK_URL=http://mock-handoff-server:9999/mock-handoff
WEBHOOK_SECRET=replace-for-local-demo-only

WORKER_OWNER=agent-flow-bootstrap
DEMO_TENANT_ID=t1
DEMO_CUSTOMER_ID=c1
APP_RUNTIME_MODE=demo

# Only needed if a profile in config/models.yaml points at a local vLLM server.
# Docker reads this file, so the host is host.docker.internal, not localhost —
# localhost inside a container is the container itself. Use localhost only when
# you run the app on the host without Docker.
LOCAL_VLLM_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_VLLM_API_KEY=EMPTY
