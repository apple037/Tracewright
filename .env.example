# Bootstrap/demo defaults only. Replace every endpoint and placeholder before
# any non-local deployment; never commit the resulting .env file.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
MODEL_CONFIG_PATH=config/models.bootstrap.example.yaml
ASSURANCE_MODE=bootstrap

# Host development uses localhost. Compose overrides this with
# http://host.docker.internal:8000/v1.
LOCAL_VLLM_BASE_URL=http://localhost:8000/v1
LOCAL_VLLM_API_KEY=EMPTY

# Flexible Ollama-compatible remote endpoint; private tags remain in model YAML.
REMOTE_MODEL_BASE_URL=http://remote-model-server:11434
REMOTE_MODEL_API_KEY=

WEBHOOK_URL=http://mock-handoff-server:9999/mock-handoff
WEBHOOK_SECRET=replace-for-local-demo-only
WORKER_OWNER=agent-flow-bootstrap
DEMO_TENANT_ID=t1
